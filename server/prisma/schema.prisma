generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  REQUESTER
  IT_STAFF
  ADMINISTRATOR
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
}

enum ActionStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ActionEventType {
  CREATED
  EDITED
  STATUS_CHANGED
  ASSIGNEE_RELEASED
}

// Expanded from the single-value Lab 2 enum [BR-12]. CLOSED and CANCELLED are terminal.
enum TicketStatus {
  NEW
  OPEN
  IN_PROGRESS
  WAITING_FOR_REQUESTER
  RESOLVED
  CLOSED
  REOPENED
  CANCELLED
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  tickets   Ticket[]
}

/// Replaces the Lab 2 RequesterUser model [FR-16, BR-06, BR-20].
/// email is a citext column, so the unique index below compares addresses
/// case-insensitively and two rows differing only in case cannot both exist
/// (BR-09). Write paths still lower-case before storing, but that is now
/// normalisation for readability rather than the thing enforcing the rule -- a
/// write path that forgets is refused by the database instead of silently
/// creating a row login could never resolve. A CHECK constraint added in the
/// same migration restates the 255-character bound that citext does not carry.
model User {
  id                 Int                     @id @default(autoincrement())
  name               String                  @db.VarChar(120)
  email              String                  @unique @db.Citext
  passwordHash       String                  @db.Text
  role               Role                    @default(REQUESTER)
  isActive           Boolean                 @default(true)
  mustChangePassword Boolean                 @default(true)
  tokenVersion       Int                     @default(0)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  requestedTickets   Ticket[]                @relation("TicketRequester")
  ownedTickets       Ticket[]                @relation("TicketOwner")
  publicComments     PublicComment[]
  internalNotes      InternalNote[]
  performedActions   ActionTaken[]           @relation("ActionPerformer")
  assignedActions    ActionTaken[]           @relation("ActionAssignee")
  actionEvents       ActionEvent[]           @relation("ActionEventActor")
  actionRequests     ActionCreationRequest[] @relation("ActionRequestActor")

  @@index([role, isActive])
}

model RelatedSystem {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(120)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  tickets   Ticket[]
}

model Ticket {
  id                Int                     @id @default(autoincrement())
  number            String                  @unique @db.VarChar(20)
  requesterId       Int
  ownerId           Int?
  categoryId        Int
  systemId          Int
  summary           String                  @db.VarChar(150)
  description       String                  @db.Text
  requestedPriority TicketPriority
  itPriority        TicketPriority
  status            TicketStatus            @default(NEW)
  appearsResolvedAt DateTime?
  resolutionSummary String?                 @db.Text
  resolvedAt        DateTime?
  version           Int                     @default(1)
  ticketDate        DateTime                @default(now())
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  requester         User                    @relation("TicketRequester", fields: [requesterId], references: [id])
  owner             User?                   @relation("TicketOwner", fields: [ownerId], references: [id])
  category          Category                @relation(fields: [categoryId], references: [id])
  system            RelatedSystem           @relation(fields: [systemId], references: [id])
  attachments       Attachment[]
  publicComments    PublicComment[]
  internalNotes     InternalNote[]
  actionsTaken      ActionTaken[]
  actionRequests    ActionCreationRequest[]

  @@index([requesterId, updatedAt(sort: Desc), id])
  @@index([requesterId, resolvedAt(sort: Desc), id])
  // The staff queue defaults to no predicate at all (D12), so an unfiltered
  // ORDER BY updatedAt DESC needs an index led by updatedAt.
  @@index([updatedAt(sort: Desc)])
  @@index([ownerId])
  @@index([ownerId, status])
}

model Attachment {
  id            Int       @id @default(autoincrement())
  ticketId      Int
  filename      String    @db.VarChar(255)
  mimeType      String    @db.VarChar(100)
  sizeBytes     Int
  data          Bytes
  uploadedAt    DateTime  @default(now())
  removedAt     DateTime?
  removedReason String?   @db.VarChar(300)
  ticket        Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

/// Visible to the requester, IT Staff and Administrators [BR-04].
model PublicComment {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  authorId  Int
  body      String   @db.Text
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id])

  @@index([ticketId, createdAt])
}

/// Visible to IT Staff and Administrators only. A separate table rather than a
/// flag on PublicComment, so authorization cannot leak through a forgotten
/// filter predicate [BR-04, D20].
model InternalNote {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  authorId  Int
  body      String   @db.Text
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id])

  @@index([ticketId, createdAt])
}

model ActionTaken {
  id               Int                    @id @default(autoincrement())
  /// Nullable for user-created actions; seed-only identity, never API input.
  seedKey          String?                @unique @db.VarChar(120)
  ticketId         Int
  title            String                 @db.VarChar(120)
  details          String                 @db.Text
  result           String?                @db.Text
  performedById    Int
  assigneeId       Int?
  status           ActionStatus           @default(PLANNED)
  followUpRequired Boolean                @default(false)
  followUpNote     String?                @db.Text
  attachmentNotes  String?                @db.Text
  version          Int                    @default(1)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  completedAt      DateTime?
  ticket           Ticket                 @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  performedBy      User                   @relation("ActionPerformer", fields: [performedById], references: [id], onDelete: Restrict)
  assignee         User?                  @relation("ActionAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  events           ActionEvent[]
  creationRequest  ActionCreationRequest?

  @@index([ticketId, createdAt, id])
  @@index([performedById, createdAt, id])
  @@index([assigneeId, status])
}

model ActionEvent {
  id              Int             @id @default(autoincrement())
  actionId        Int
  actorId         Int
  type            ActionEventType
  previousVersion Int?
  newVersion      Int
  occurredAt      DateTime        @default(now())
  before          Json?
  after           Json
  action          ActionTaken     @relation(fields: [actionId], references: [id], onDelete: Restrict)
  actor           User            @relation("ActionEventActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actionId, occurredAt, id])
  @@index([actorId, occurredAt])
}

model ActionCreationRequest {
  id                 Int         @id @default(autoincrement())
  actorId            Int
  key                String      @db.VarChar(255)
  ticketId           Int
  actionId           Int         @unique
  payloadFingerprint String      @db.VarChar(64)
  payload            Json
  response           Json
  createdAt          DateTime    @default(now())
  actor              User        @relation("ActionRequestActor", fields: [actorId], references: [id], onDelete: Restrict)
  ticket             Ticket      @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  action             ActionTaken @relation(fields: [actionId], references: [id], onDelete: Restrict)

  @@unique([actorId, key])
  @@index([ticketId, createdAt])
}
