  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.15.0",
    "@types/supertest": "^6.0.2",
    "prisma": "^6.11.0",
    "supertest": "^7.1.0",
    "tsx": "^4.19.0",
