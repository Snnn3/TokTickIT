# Server
PORT=3000

# PostgreSQL
# Copy this file to .env and replace with your real credentials.
# Default local setup uses Docker: docker compose up -d db
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5434/toktickit"

# Lab 3 authentication
# Session cookie is signed with this secret. Generate your own for local dev,
# e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`.
# Never commit a real value.
JWT_SECRET="replace-with-a-long-random-local-only-value"

# Password given to every seeded and migrated account. Local development only.
# The seed falls back to the value documented in the README when this is unset.
# Every seeded user must change it at first sign-in.
SEED_INITIAL_PASSWORD="ChangeMe!2026"
